# Copy this file to `.env` for local dev. Never commit the real .env.
#
# Vercel: add the VITE_* vars under Project Settings → Environment Variables.
# Only the VITE_-prefixed ones are needed at build time — Vite inlines them.
#
# The unprefixed SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY duplicates are
# convenient if you run `scripts/seed-users.mjs` or other Node tooling that
# reads `process.env` directly. The seed script also needs your
# SUPABASE_SERVICE_ROLE_KEY — keep that one strictly local, never in Vercel.

VITE_SUPABASE_URL="https://<project>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Duplicates for local Node scripts (optional)
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<anon-key>"

# DO NOT add SUPABASE_SERVICE_ROLE_KEY here unless you're about to run a
# privileged script — and never commit a file that contains it.
